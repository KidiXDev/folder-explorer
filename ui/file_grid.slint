import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FileRow, Span } from "types.slint";
import { DimLabel, DragPreview, EmptyState, FileIcon, ItemTouchArea, Label, LoadingSpinner, MarqueeArea, RenameBox } from "controls.slint";

component GridCell {
    in property <FileRow> data;
    in property <length> icon-size;
    in property <bool> stacked;
    in property <bool> tile;
    in property <bool> renaming;
    in property <bool> drop-target;
    in property <MouseCursor> drag-cursor;
    callback touched <=> touch.touched;
    callback pressed <=> touch.item-pressed;
    callback right-pressed <=> touch.right-pressed;
    callback activated <=> touch.double-clicked;
    callback drag-started <=> touch.drag-started;
    callback drag-moved <=> touch.drag-moved;
    callback drag-ended <=> touch.drag-ended;
    callback drag-cancelled <=> touch.drag-cancelled;

    Rectangle {
        x: Theme.tile-inset;
        y: Theme.item-inset;
        width: parent.width - 2 * Theme.tile-inset;
        height: parent.height - 2 * Theme.item-inset;
        border-radius: Theme.radius;
        border-width: root.data.selected || root.drop-target || (root.tile && touch.has-hover) ? 1px : 0px;
        border-color: root.drop-target ? Theme.accent : root.data.selected ? Theme.selected-border : Theme.line;
        background: root.drop-target ? Theme.selected-hover
            : root.data.selected ? (touch.has-hover ? Theme.selected-hover : Theme.selected)
            : touch.pressed ? Theme.pressed
            : touch.has-hover ? Theme.hover
            : transparent;
    }

    if !root.stacked: Rectangle {
        x: 3px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.data.selected ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        opacity: root.data.selected ? 1 : 0;
        animate height { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 130ms; easing: ease-out; }
    }

    if root.stacked: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 4px;
        width: root.data.selected ? 20px : 0px;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.accent;
        opacity: root.data.selected ? 1 : 0;
        animate width { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 130ms; easing: ease-out; }
    }

    if root.stacked: VerticalLayout {
        alignment: start;
        padding: 10px;
        spacing: 2px;

        Rectangle {
            height: root.icon-size;

            FileIcon {
                width: root.icon-size;
                height: root.icon-size;
                icon: root.data.icon;
                folder: root.data.folder;
                dim: root.data.dim;
            }
        }

        Text {
            max-lines: 2;
            height: self.preferred-height + 6px;
            vertical-alignment: center;
            text: root.data.cells[0];
            opacity: root.renaming ? 0 : 1;
            color: root.data.dim ? Theme.text-dim : Theme.text;
            font-size: Theme.text-size;
            font-weight: root.data.selected ? 500 : 400;
            wrap: word-wrap;
            overflow: elide;
            horizontal-alignment: center;
        }

        DimLabel {
            vertical-stretch: 0;
            text: root.data.cells[1];
            color: root.data.warn ? Theme.warning : Theme.text-dim;
            horizontal-alignment: center;
        }
    }

    if !root.stacked: HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        Rectangle {
            width: root.icon-size;

            FileIcon {
                width: root.icon-size;
                height: root.icon-size;
                icon: root.data.icon;
                folder: root.data.folder;
                dim: root.data.dim;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Label {
                text: root.data.cells[0];
                opacity: root.renaming ? 0 : 1;
                font-weight: root.data.selected ? 500 : 400;
                color: root.data.dim ? Theme.text-dim : Theme.text;
            }

            if root.tile: DimLabel {
                text: root.data.subtitle;
            }

            if root.tile: DimLabel {
                text: root.data.cells[1];
                color: root.data.warn ? Theme.warning : Theme.text-dim;
            }
        }

        if !root.tile: DimLabel {
            text: root.data.cells[1];
            color: root.data.warn ? Theme.warning : Theme.text-dim;
            horizontal-stretch: 0;
        }
    }

    touch := ItemTouchArea {
        x: Theme.tile-inset;
        y: Theme.item-inset;
        width: parent.width - 2 * Theme.tile-inset;
        height: parent.height - 2 * Theme.item-inset;
        selected: root.data.selected;
        drag-cursor: root.drag-cursor;
    }
}

export component FileGrid {
    in property <[FileRow]> rows;
    in property <int> view;
    in property <string> empty-message;
    in property <int> drag-count;
    callback row-pressed(int, bool, bool);
    callback row-menu(int, length, length);
    callback background-menu(length, length);
    callback background-pressed();
    callback marquee-started(bool);
    callback marquee-changed(Span, Span, int);
    callback items-dropped(int, bool);
    callback row-activated(int);
    callback rename-committed(string);
    callback rename-cancelled();

    property <bool> stacked: root.view <= 2;
    property <bool> tiles: root.view == 6;
    property <bool> column-major: root.view == 4;
    property <length> gutter: 10px;
    property <length> icon-size: root.view == 0 ? 256px
        : root.view == 1 ? 96px
        : root.view == 2 || root.tiles ? 48px
        : 16px;
    property <length> cell-width: root.view == 0 ? 280px
        : root.view == 1 ? 136px
        : root.view == 2 ? 112px
        : root.tiles ? 304px
        : 270px;
    property <length> cell-height: root.view == 0 ? 336px
        : root.view == 1 ? 172px
        : root.view == 2 ? 124px
        : root.tiles ? 78px
        : Theme.row-height;
    property <int> columns: max(1, floor((root.width - 2 * root.gutter - 8px) / root.cell-width));
    property <int> lines: ceil(root.rows.length / root.columns);
    property <int> rename-index: -1;
    property <int> drag-source;
    property <length> drag-top: marquee.local-y - list.content-y;
    property <length> drag-left: marquee.local-x - list.content-x - root.gutter;
    property <int> drag-line: floor(root.drag-top / root.cell-height);
    property <int> drag-column: floor(root.drag-left / root.cell-width);
    property <int> drag-index: root.index-at(root.drag-line, root.drag-column);
    property <length> drag-offset-y: root.drag-top - root.drag-line * root.cell-height;
    property <length> drag-offset-x: root.drag-left - root.drag-column * root.cell-width;
    property <bool> drag-on-cell: marquee.local-y >= 0 && marquee.local-y < list.visible-height
        && root.drag-line >= 0 && root.drag-line < root.lines && root.drag-column >= 0 && root.drag-column < root.columns
        && root.drag-offset-y >= Theme.item-inset && root.drag-offset-y < root.cell-height - Theme.item-inset
        && root.drag-offset-x >= Theme.tile-inset && root.drag-offset-x < root.cell-width - Theme.tile-inset;
    property <int> drop-index: marquee.dragging-items && root.drag-on-cell && root.drag-index < root.rows.length
        && root.rows[root.drag-index].folder && !root.rows[root.drag-index].selected ? root.drag-index : -1;
    property <MouseCursor> drag-cursor: !marquee.dragging-items ? MouseCursor.default
        : root.drop-index < 0 ? MouseCursor.no-drop
        : marquee.drag-copy ? MouseCursor.copy
        : MouseCursor.move;

    out property <int> vertical-step: root.column-major ? 1 : root.columns;
    out property <int> horizontal-step: root.column-major ? root.lines : 1;
    out property <int> page-step: root.vertical-step * max(1, floor(root.height / root.cell-height));

    forward-focus: focus;

    pure function index-at(line: int, column: int) -> int {
        return root.column-major ? column * root.lines + line : line * root.columns + column;
    }

    pure function line-of(index: int) -> int {
        return root.column-major ? mod(index, max(1, root.lines)) : floor(index / root.columns);
    }

    pure function column-of(index: int) -> int {
        return root.column-major ? floor(index / max(1, root.lines)) : mod(index, root.columns);
    }

    public function reveal-row(index: int) {
        if (root.line-of(index) * root.cell-height + list.content-y < 0) {
            list.content-y = 0 - root.line-of(index) * root.cell-height;
        } else if ((root.line-of(index) + 1) * root.cell-height + list.content-y > list.visible-height) {
            list.content-y = list.visible-height - (root.line-of(index) + 1) * root.cell-height;
        }
    }

    public function scroll-to-top() {
        list.content-y = 0;
    }

    public function take-focus() {
        focus.focus();
    }

    public function begin-rename(index: int, name: string, selection-end: int) {
        root.rename-index = index;
        root.reveal-row(index);
        rename-box.start(name, selection-end);
    }

    public pure function menu-anchor(index: int) -> Point {
        return {
            x: root.gutter + root.column-of(index) * root.cell-width + 12px,
            y: max(0px, (root.line-of(index) + 1) * root.cell-height + list.content-y),
        };
    }

    focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape && marquee.dragging) {
                marquee.cancel();
                return accept;
            }
            reject
        }

        Rectangle {
            clip: true;

            marquee := MarqueeArea {
                width: parent.width;
                height: parent.height;
                scroll-x: list.content-x;
                scroll-y <=> list.content-y;
                scroll-limit: min(0px, list.visible-height - list.content-height);
                touched => { focus.focus(); }
                background-pressed => { root.background-pressed(); }
                background-menu(x, y) => { root.background-menu(x, y); }
                started(additive) => { root.marquee-started(additive); }
                changed(left, top, right, bottom) => {
                    let lines = { start: top, end: bottom, pitch: root.cell-height, inset: Theme.item-inset };
                    let columns = { start: left - root.gutter, end: right - root.gutter, pitch: root.cell-width, inset: Theme.tile-inset };
                    if (root.column-major) {
                        root.marquee-changed(columns, lines, root.lines);
                    } else {
                        root.marquee-changed(lines, columns, root.columns);
                    }
                }
                items-dropped(copy) => {
                    if (root.drop-index >= 0) {
                        root.items-dropped(root.drop-index, copy);
                    }
                }

                list := ListView {
                    width: parent.width;
                    height: parent.height;

                    for line in root.lines: Rectangle {
                        height: root.cell-height;

                        for column in root.columns: slot := Rectangle {
                            property <int> index: root.index-at(line, column);

                            x: root.gutter + column * root.cell-width;
                            width: root.cell-width;

                            if slot.index < root.rows.length: GridCell {
                                width: parent.width;
                                height: parent.height;
                                data: root.rows[slot.index];
                                icon-size: root.icon-size;
                                stacked: root.stacked;
                                tile: root.tiles;
                                renaming: rename-box.active && root.rename-index == slot.index;
                                drop-target: root.drop-index == slot.index;
                                drag-cursor: root.drag-cursor;
                                touched => { focus.focus(); }
                                pressed(control, shift) => { root.row-pressed(slot.index, control, shift); }
                                right-pressed(x, y) => { root.row-menu(slot.index, x, y); }
                                activated => { root.row-activated(slot.index); }
                                drag-started(selecting, x, y) => {
                                    root.drag-source = slot.index;
                                    marquee.item-drag-started(selecting, x, y);
                                }
                                drag-moved(x, y, copy) => { marquee.item-drag-moved(x, y, copy); }
                                drag-ended(copy) => { marquee.item-drag-ended(copy); }
                                drag-cancelled => { marquee.cancel(); }
                            }
                        }
                    }
                }
            }

            rename-box := RenameBox {
                x: root.gutter + root.column-of(root.rename-index) * root.cell-width
                    + (root.stacked ? (root.cell-width - self.width) / 2 : root.icon-size + 22px - self.inset);
                y: root.line-of(root.rename-index) * root.cell-height + list.content-y
                    + (root.stacked ? root.icon-size + 12px : root.tiles ? 9px : (root.cell-height - self.height) / 2);
                available-width: root.cell-width - (root.stacked ? 12px : root.icon-size + 26px);
                committed(text) => { root.rename-committed(text); }
                cancelled => { root.rename-cancelled(); }
            }

            if root.rows.length == 0 && root.empty-message != "": EmptyState {
                width: parent.width;
                height: parent.height;
                message: root.empty-message;
            }
        }

        if marquee.dragging-items: DragPreview {
            width: parent.width;
            height: parent.height;
            pointer-x: marquee.absolute-position.x + marquee.local-x - self.absolute-position.x;
            pointer-y: marquee.absolute-position.y + marquee.local-y - self.absolute-position.y;
            icon: root.rows[root.drag-source].icon;
            folder: root.rows[root.drag-source].folder;
            count: root.drag-count;
            copy: marquee.drag-copy;
            target: root.drop-index >= 0 ? root.rows[root.drop-index].cells[0] : "";
        }
    }
}
