import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> text: Palette.foreground;
    out property <brush> accent: Palette.accent-background;

    out property <brush> window-bg: dark
        ? @linear-gradient(140deg, #1d2028 0%, #181b22 50%, #15181f 100%)
        : @linear-gradient(140deg, #eaf0f8 0%, #f2f5fb 50%, #ebf0f8 100%);

    out property <brush> header: dark
        ? @linear-gradient(180deg, #ffffff07 0%, #ffffff02 100%)
        : @linear-gradient(180deg, #ffffff70 0%, #ffffff30 100%);
    out property <brush> commandbar: dark
        ? @linear-gradient(180deg, #ffffff05 0%, #ffffff02 100%)
        : @linear-gradient(180deg, #ffffff55 0%, #ffffff38 100%);
    out property <brush> panel: dark ? #ffffff02 : #ffffff40;
    out property <brush> surface: dark
        ? @linear-gradient(180deg, #ffffff07 0%, #ffffff04 100%)
        : @linear-gradient(180deg, #ffffffd8 0%, #ffffffeb 100%);
    out property <brush> subtle-surface: dark ? #ffffff05 : #ffffff88;

    out property <brush> flyout: dark
        ? @linear-gradient(165deg, #2b2f38f8 0%, #22252df8 100%)
        : @linear-gradient(165deg, #fffffffc 0%, #f3f6fcfc 100%);
    out property <brush> flyout-border: dark
        ? @linear-gradient(180deg, #ffffff28 0%, #ffffff12 100%)
        : @linear-gradient(180deg, #ffffff 0%, #00000018 100%);

    out property <brush> card: dark
        ? @linear-gradient(180deg, #ffffff11 0%, #ffffff09 100%)
        : @linear-gradient(180deg, #fffffff2 0%, #ffffffd8 100%);
    out property <brush> card-hover: dark
        ? @linear-gradient(180deg, #ffffff18 0%, #ffffff0f 100%)
        : #ffffff;
    out property <brush> card-border: dark
        ? @linear-gradient(180deg, #ffffff20 0%, #ffffff0d 100%)
        : @linear-gradient(180deg, #ffffff 0%, #00000014 100%);
    out property <brush> control-border: dark
        ? @linear-gradient(180deg, #ffffff1c 0%, #ffffff0d 100%)
        : @linear-gradient(180deg, #ffffffc0 0%, #00000016 100%);

    out property <brush> input-bg: dark
        ? @linear-gradient(180deg, #ffffff12 0%, #ffffff0b 100%)
        : @linear-gradient(180deg, #ffffffd8 0%, #ffffffb8 100%);
    out property <brush> input-hover: dark
        ? @linear-gradient(180deg, #ffffff19 0%, #ffffff11 100%)
        : @linear-gradient(180deg, #fffffff5 0%, #ffffffdc 100%);
    out property <color> input-active: dark ? #14161ce8 : #ffffff;
    out property <brush> input-border: dark
        ? @linear-gradient(180deg, #ffffff18 0%, #ffffff14 90%, #ffffff58 100%)
        : @linear-gradient(180deg, #0000000e 0%, #0000000e 90%, #00000050 100%);
    out property <brush> input-border-hover: dark
        ? @linear-gradient(180deg, #ffffff24 0%, #ffffff1e 90%, #ffffff78 100%)
        : @linear-gradient(180deg, #00000016 0%, #00000016 90%, #0000006c 100%);

    out property <color> text-dim: dark ? #ffffffb5 : #0000009e;
    out property <color> text-faint: dark ? #ffffff64 : #00000058;

    out property <color> line: dark ? #ffffff0e : #0000000c;
    out property <color> line-strong: dark ? #ffffff1e : #00000018;
    out property <brush> hover: dark
        ? @linear-gradient(180deg, #ffffff12 0%, #ffffff0c 100%)
        : @linear-gradient(180deg, #ffffff80 0%, #00000008 100%);
    out property <color> pressed: dark ? #ffffff09 : #0000000c;

    out property <brush> selected: dark
        ? @linear-gradient(180deg, #4cc2ff22 0%, #4cc2ff16 100%)
        : @linear-gradient(180deg, #0067c016 0%, #0067c00e 100%);
    out property <brush> selected-hover: dark
        ? @linear-gradient(180deg, #4cc2ff2e 0%, #4cc2ff20 100%)
        : @linear-gradient(180deg, #0067c022 0%, #0067c016 100%);
    out property <color> selected-border: dark ? #4cc2ff38 : #0067c028;

    out property <color> track: dark ? #ffffff16 : #00000012;
    out property <color> folder: dark ? #f7c552 : #e8ab2e;
    out property <color> warning: dark ? #fce100 : #9d5d00;
    out property <color> warning-bg: dark ? #fce1001a : #9d5d0012;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> backdrop: dark ? #00000070 : #00000034;
    out property <color> caption-close: #c42b1c;
    out property <color> caption-close-pressed: #a82418;

    out property <length> row-height: 30px;
    out property <length> titlebar-height: 32px;
    out property <length> toolbar-height: 44px;
    out property <length> commandbar-height: 42px;
    out property <length> statusbar-height: 28px;
    out property <length> radius-sm: 4px;
    out property <length> radius: 6px;
    out property <length> radius-lg: 8px;
    out property <length> text-size: 13px;
    out property <length> small-text-size: 12px;
}
