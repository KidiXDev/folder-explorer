import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> surface: Palette.background;
    out property <brush> text: Palette.foreground;
    out property <brush> accent: Palette.accent-background;

    out property <color> header: dark ? #1b1b1b : #eef0f3;
    out property <color> panel: dark ? #202020 : #f4f5f7;
    out property <color> subtle-surface: dark ? #1e1e1e : #f9fafb;
    out property <color> card: dark ? #262626 : #ffffff;
    out property <color> card-hover: dark ? #2d2d2d : #f8f9fb;
    out property <color> card-border: dark ? #ffffff16 : #00000014;
    out property <color> input-bg: dark ? #161616 : #ffffff;
    out property <color> input-hover: dark ? #1b1b1b : #fcfcfd;

    out property <color> text-dim: dark ? #ffffffa6 : #0000009e;
    out property <color> text-faint: dark ? #ffffff5c : #00000054;

    out property <color> line: dark ? #ffffff14 : #00000012;
    out property <color> line-strong: dark ? #ffffff26 : #00000022;
    out property <color> hover: dark ? #ffffff10 : #00000009;
    out property <color> pressed: dark ? #ffffff18 : #00000013;

    out property <color> selected: dark ? #4cc2ff22 : #0067c016;
    out property <color> selected-hover: dark ? #4cc2ff30 : #0067c022;
    out property <color> selected-border: dark ? #4cc2ff45 : #0067c035;

    out property <color> track: dark ? #ffffff18 : #00000012;
    out property <color> folder: dark ? #f5c156 : #eab038;
    out property <color> warning: dark ? #fce100 : #9d5d00;
    out property <color> warning-bg: dark ? #fce1001c : #9d5d0014;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <color> backdrop: dark ? #00000078 : #00000040;

    out property <length> row-height: 30px;
    out property <length> toolbar-height: 50px;
    out property <length> commandbar-height: 44px;
    out property <length> statusbar-height: 32px;
    out property <length> radius-sm: 4px;
    out property <length> radius: 6px;
    out property <length> radius-lg: 8px;
    out property <length> text-size: 13px;
    out property <length> small-text-size: 12px;
}
