import { Palette } from "std-widgets.slint";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> surface: Palette.background;
    out property <brush> text: Palette.foreground;
    out property <brush> accent: Palette.accent-background;
    out property <color> panel: dark ? #202020 : #f3f3f3;
    out property <color> text-dim: dark ? #ffffff9c : #0000009c;
    out property <color> text-faint: dark ? #ffffff5c : #0000005c;
    out property <color> line: dark ? #ffffff14 : #0000000f;
    out property <color> hover: dark ? #ffffff0f : #0000000a;
    out property <color> pressed: dark ? #ffffff17 : #00000012;
    out property <color> selected: dark ? #ffffff1f : #0067c01f;
    out property <color> track: dark ? #ffffff1a : #00000014;
    out property <color> folder: #f2b94b;
    out property <color> warning: dark ? #fce100 : #9d5d00;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;
    out property <length> row-height: 28px;
    out property <length> toolbar-height: 48px;
    out property <length> radius: 4px;
    out property <length> text-size: 13px;
    out property <length> small-text-size: 12px;
}
