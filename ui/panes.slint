import { ListView, ScrollView, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DriveCard, SummaryRow, TreeRow } from "types.slint";
import { DimLabel, EmptyState, IconButton, Label, UsageBar } from "controls.slint";

component TreeItem {
    in property <TreeRow> data;
    in property <bool> separated;
    callback opened();
    callback toggled();

    property <bool> appeared: false;
    property <length> gap: root.separated ? 11px : 0px;
    init => { root.appeared = true; }

    height: Theme.row-height + root.gap;
    opacity: root.appeared ? 1 : 0;
    animate opacity { duration: 150ms; easing: ease-out; }

    if root.separated: Rectangle {
        x: 12px;
        y: 5px;
        width: root.width - 24px;
        height: 1px;
        background: Theme.line;
    }

    Rectangle {
        x: 6px;
        y: root.gap + 1px;
        width: root.width - 12px;
        height: Theme.row-height - 2px;
        border-radius: Theme.radius;
        border-width: root.data.selected ? 1px : 0px;
        border-color: Theme.selected-border;
        background: root.data.selected ? (open.has-hover ? Theme.selected-hover : Theme.selected)
            : open.pressed ? Theme.pressed
            : open.has-hover ? Theme.hover
            : transparent;
    }

    Rectangle {
        x: 6px;
        y: root.gap + (Theme.row-height - self.height) / 2;
        width: 3px;
        height: root.data.selected ? 15px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        opacity: root.data.selected ? 1 : 0;
        animate height { duration: 170ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 140ms; easing: ease-out; }
    }

    open := TouchArea {
        y: root.gap;
        height: Theme.row-height;
        mouse-cursor: pointer;
        clicked => { root.opened(); }
    }

    HorizontalLayout {
        y: root.gap;
        height: Theme.row-height;
        padding-left: (root.appeared ? 10px : 4px) + root.data.depth * 14px;
        padding-right: 10px;
        spacing: 6px;
        animate padding-left { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

        Rectangle {
            width: 18px;

            if root.data.expandable: Rectangle {
                width: 18px;
                height: 18px;
                border-radius: Theme.radius-sm;
                background: toggle-touch.pressed ? Theme.pressed : toggle-touch.has-hover ? Theme.hover : transparent;

                Image {
                    source: @image-url("icons/chevron-right.svg");
                    width: 12px;
                    height: 12px;
                    colorize: toggle-touch.has-hover ? Theme.text : Theme.text-dim;
                    transform-rotation: root.data.expanded ? 90deg : 0deg;
                    animate transform-rotation { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                    animate colorize { duration: 120ms; }
                }
            }

            toggle-touch := TouchArea {
                enabled: root.data.expandable;
                mouse-cursor: root.data.expandable ? pointer : default;
                clicked => { root.toggled(); }
            }
        }

        Image {
            width: 16px;
            image-fit: contain;
            source: root.data.icon.width > 0 ? root.data.icon
                : root.data.kind == 0 ? @image-url("icons/computer.svg")
                : root.data.kind == 1 ? @image-url("icons/drive.svg")
                : @image-url("icons/folder.svg");
            colorize: root.data.icon.width > 0 ? transparent
                : root.data.kind == 2 || root.data.kind == 3 ? Theme.folder
                : root.data.selected ? Theme.accent
                : Theme.text-dim;
        }

        Label {
            text: root.data.name;
            font-weight: root.data.selected ? 600 : 400;
            horizontal-stretch: 1;
        }
    }
}

export component Sidebar {
    in property <[TreeRow]> rows;
    callback opened(int);
    callback toggled(int);

    property <length> item-height: Theme.row-height;

    public function reveal-row(row: int) {
        if (row * item-height + list.content-y < 0) {
            list.content-y = 0 - row * item-height;
        } else if ((row + 1) * item-height + list.content-y > list.visible-height) {
            list.content-y = list.visible-height - (row + 3) * item-height;
        }
    }

    VerticalLayout {
        padding-top: 6px;
        padding-bottom: 4px;

        list := ListView {
            vertical-stretch: 1;

            for row[index] in root.rows: TreeItem {
                data: row;
                separated: index > 0 && row.kind == 0;
                opened => { root.opened(index); }
                toggled => { root.toggled(index); }
            }
        }
    }
}

component DriveTile {
    in property <DriveCard> drive;
    callback opened();

    Rectangle {
        border-radius: Theme.radius;
        background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        double-clicked => { root.opened(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 14px;

        Rectangle {
            width: 44px;

            Image {
                source: root.drive.icon.width > 0 ? root.drive.icon : @image-url("icons/drive.svg");
                width: 44px;
                height: 44px;
                image-fit: contain;
                colorize: root.drive.icon.width > 0 ? transparent : Theme.text-dim;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 6px;

                Label {
                    text: root.drive.title;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }

                if root.drive.nearly-full: Rectangle {
                    width: low-space.preferred-width + 10px;

                    Rectangle {
                        width: parent.width;
                        height: 18px;
                        border-radius: Theme.radius-sm;
                        background: Theme.warning-bg;

                        low-space := Text {
                            text: "Low space";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.danger;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            UsageBar {
                height: 8px;
                ratio: root.drive.ratio;
                nearly-full: root.drive.nearly-full;
            }

            HorizontalLayout {
                spacing: 6px;

                DimLabel {
                    text: root.drive.detail;
                    horizontal-stretch: 1;
                }

                if root.drive.ratio > 0: DimLabel {
                    text: round(root.drive.ratio * 100) + "%";
                    font-weight: 600;
                    color: root.drive.nearly-full ? Theme.danger : Theme.text-dim;
                    horizontal-stretch: 0;
                }
            }
        }
    }
}

component DriveSectionHeader {
    in property <string> title;
    in property <int> count;
    in-out property <bool> expanded: true;

    height: 32px;

    HorizontalLayout {
        spacing: 8px;

        Rectangle {
            width: header-row.preferred-width + 12px;
            border-radius: Theme.radius-sm;
            background: toggle.pressed ? Theme.pressed : toggle.has-hover ? Theme.hover : transparent;

            header-row := HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 6px;

                Rectangle {
                    width: 12px;

                    Image {
                        source: @image-url("icons/chevron-down.svg");
                        width: 11px;
                        height: 11px;
                        colorize: Theme.text-dim;
                        transform-rotation: root.expanded ? 0deg : -90deg;
                        animate transform-rotation { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                    }
                }

                Text {
                    text: root.title;
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                DimLabel {
                    text: "(" + root.count + ")";
                    font-weight: 500;
                }
            }

            toggle := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.expanded = !root.expanded; }
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            Rectangle {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                height: 1px;
                background: Theme.line;
            }
        }
    }
}

export component DrivesView {
    in property <[DriveCard]> drives;
    in property <[DriveCard]> network-drives;
    callback opened(string);

    property <length> tile-width: 312px;
    property <length> tile-height: 82px;
    property <length> gap: 12px;
    property <length> section-header-height: 40px;
    property <int> per-row: max(1, floor((self.width - 2 * gap) / (tile-width + gap)));

    property <bool> drives-expanded: true;
    property <bool> network-expanded: true;

    property <int> drive-rows: root.drives-expanded ? ceil(root.drives.length / root.per-row) : 0;
    property <int> network-rows: root.network-expanded ? max(1, ceil(root.network-drives.length / root.per-row)) : 0;

    property <length> drives-start-y: 14px + root.section-header-height;
    property <length> network-header-y: root.drives-start-y
        + (root.drives-expanded ? root.drive-rows * (root.tile-height + root.gap) + 10px : 6px);
    property <length> network-start-y: root.network-header-y + root.section-header-height;

    ScrollView {
        width: parent.width;
        height: parent.height;
        content-height: root.network-start-y
            + (root.network-expanded
                ? (root.network-drives.length > 0
                    ? root.network-rows * (root.tile-height + root.gap)
                    : 36px)
                : 0px)
            + root.gap;

        DriveSectionHeader {
            x: root.gap;
            y: 14px;
            width: max(0px, root.width - 2 * root.gap);
            title: "Devices and drives";
            count: root.drives.length;
            expanded <=> root.drives-expanded;
        }

        if root.drives-expanded: Rectangle {
            for drive[index] in root.drives: DriveTile {
                x: root.gap + mod(index, root.per-row) * (root.tile-width + root.gap);
                y: root.drives-start-y + floor(index / root.per-row) * (root.tile-height + root.gap);
                width: root.tile-width;
                height: root.tile-height;
                drive: drive;
                opened => { root.opened(drive.path); }
            }
        }

        DriveSectionHeader {
            x: root.gap;
            y: root.network-header-y;
            width: max(0px, root.width - 2 * root.gap);
            title: "Network locations";
            count: root.network-drives.length;
            expanded <=> root.network-expanded;
        }

        if root.network-expanded && root.network-drives.length == 0: DimLabel {
            x: root.gap + 24px;
            y: root.network-start-y;
            height: 28px;
            text: "No network locations connected";
        }

        if root.network-expanded: Rectangle {
            for drive[index] in root.network-drives: DriveTile {
                x: root.gap + mod(index, root.per-row) * (root.tile-width + root.gap);
                y: root.network-start-y + floor(index / root.per-row) * (root.tile-height + root.gap);
                width: root.tile-width;
                height: root.tile-height;
                drive: drive;
                opened => { root.opened(drive.path); }
            }
        }
    }
}

component SummaryTab {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    horizontal-stretch: 1;
    height: 26px;

    Rectangle {
        border-radius: Theme.radius-sm;
        border-width: root.active ? 1px : 0px;
        border-color: Theme.card-border;
        background: root.active ? Theme.card : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: 140ms; easing: ease-out; }
    }

    text := DimLabel {
        text: root.label;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        color: root.active ? Theme.text : Theme.text-dim;
        animate color { duration: 140ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SummaryItem {
    in property <SummaryRow> data;
    callback activated();

    height: 44px;

    Rectangle {
        x: 6px;
        y: 1px;
        width: root.width - 12px;
        height: parent.height - 2px;
        border-radius: Theme.radius;
        border-width: touch.has-hover ? 1px : 0px;
        border-color: Theme.line;
        background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; easing: ease-out; }
    }

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 7px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;

            Label {
                text: root.data.label;
                font-weight: 500;
                horizontal-stretch: 1;
            }

            DimLabel {
                text: root.data.detail;
                horizontal-stretch: 0;
                horizontal-alignment: right;
            }
        }

        UsageBar {
            height: 4px;
            ratio: root.data.ratio;
        }
    }

    touch := TouchArea {
        double-clicked => { root.activated(); }
    }
}

export component SummaryPane {
    in property <[SummaryRow]> rows;
    in property <int> kind;
    in property <string> hint;
    callback kind-chosen(int);
    callback activated(int);

    VerticalLayout {
        VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 8px;

            HorizontalLayout {
                padding-left: 2px;
                padding-right: 2px;

                Text {
                    text: "Folder breakdown";
                    font-size: Theme.small-text-size;
                    font-weight: 600;
                    color: Theme.text-dim;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                DimLabel {
                    text: "Double-click to filter";
                    font-size: 11px;
                    color: Theme.text-faint;
                }
            }

            Rectangle {
                height: 32px;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.subtle-surface;

                HorizontalLayout {
                    padding: 3px;
                    spacing: 2px;

                    for label[index] in ["Type", "Modified", "Created", "Accessed"]: SummaryTab {
                        label: label;
                        active: index == root.kind;
                        clicked => { root.kind-chosen(index); }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        Rectangle {
            vertical-stretch: 1;

            ListView {
                width: parent.width;
                height: parent.height;

                for row[index] in root.rows: SummaryItem {
                    data: row;
                    activated => { root.activated(index); }
                }
            }

            if root.rows.length == 0 && root.hint != "": EmptyState {
                width: parent.width;
                height: parent.height;
                icon: @image-url("icons/summary.svg");
                message: root.hint;
            }
        }
    }
}

export component ErrorPanel {
    in property <[string]> errors;
    callback closed();

    Rectangle {
        background: Theme.card;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000060;
        drop-shadow-offset-y: 8px;
    }

    TouchArea { }

    VerticalLayout {
        padding: 20px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;

            Rectangle {
                width: 32px;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.radius;
                    background: Theme.warning-bg;

                    Image {
                        source: @image-url("icons/warning.svg");
                        width: 18px;
                        height: 18px;
                        colorize: Theme.warning;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Label {
                    text: "Items that could not be read";
                    font-weight: 600;
                }

                DimLabel {
                    text: "Sizes that include these items are shown with ≥ because the real total may be larger.";
                    wrap: word-wrap;
                }
            }

            Button {
                text: "Close";
                clicked => { root.closed(); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.subtle-surface;
            clip: true;

            ListView {
                width: parent.width;
                height: parent.height;

                for error[index] in root.errors: Rectangle {
                    height: 28px;
                    background: mod(index, 2) == 1 ? Theme.hover : transparent;

                    DimLabel {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: error;
                    }
                }
            }
        }
    }
}
