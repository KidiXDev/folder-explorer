import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ColumnInfo, FileRow } from "types.slint";
import { DimLabel, EmptyState, FileIcon, LoadingSpinner, RenameBox } from "controls.slint";

component HeaderCell {
    in property <ColumnInfo> info;
    callback clicked();
    callback resized(length);

    width: root.info.width;

    Rectangle {
        background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; easing: ease-out; }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 2px;
        width: root.info.sort-direction != 0 ? parent.width - 16px : 0px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
        opacity: root.info.sort-direction != 0 ? 1 : 0;
        animate width { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 140ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 5px;
        alignment: root.info.right-aligned ? end : start;

        DimLabel {
            text: root.info.title;
            font-weight: root.info.sort-direction != 0 ? 600 : 500;
            color: root.info.sort-direction != 0 || touch.has-hover ? Theme.text : Theme.text-dim;
            horizontal-stretch: 0;
            animate color { duration: 120ms; }
        }

        if root.info.sort-direction != 0: Image {
            source: @image-url("icons/chevron-up.svg");
            width: 12px;
            colorize: Theme.accent;
            transform-rotation: root.info.sort-direction > 0 ? 0deg : 180deg;
            animate transform-rotation { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        y: 6px;
        width: resize-touch.has-hover || resize-touch.pressed ? 2px : 1px;
        height: parent.height - 12px;
        background: resize-touch.has-hover || resize-touch.pressed ? Theme.accent : Theme.line;
        animate background, width { duration: 120ms; }
    }

    resize-touch := TouchArea {
        x: parent.width - 5px;
        width: 8px;
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.resized(max(56px, root.info.width + self.mouse-x - self.pressed-x));
            }
        }
    }
}

component Row {
    in property <FileRow> data;
    in property <[ColumnInfo]> columns;
    in property <length> total-width;
    in property <bool> renaming;
    callback pressed(bool, bool);
    callback background-pressed();
    callback right-pressed(length, length);
    callback background-menu(length, length);
    callback activated();

    height: Theme.row-height;
    min-width: root.total-width;
    property <bool> hovered: touch.has-hover && touch.mouse-x < root.total-width;

    Rectangle {
        x: 6px;
        y: 1px;
        width: root.total-width - 12px;
        height: parent.height - 2px;
        border-radius: Theme.radius;
        border-width: root.data.selected ? 1px : 0px;
        border-color: Theme.selected-border;
        background: root.data.selected ? (root.hovered ? Theme.selected-hover : Theme.selected)
            : root.hovered && touch.pressed ? Theme.pressed
            : root.hovered ? Theme.hover
            : transparent;
    }

    Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.data.selected ? 14px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        opacity: root.data.selected ? 1 : 0;
        animate height { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 130ms; easing: ease-out; }
    }

    if root.data.ratio > 0: Rectangle {
        x: root.columns[0].width + 6px;
        y: 5px;
        width: root.columns[1].width - 12px;
        height: parent.height - 10px;
        border-radius: Theme.radius-sm;
        background: Theme.track;
        opacity: 0.35;
    }

    if root.data.ratio > 0: Rectangle {
        x: root.columns[0].width + 6px;
        y: 5px;
        width: max(3px, (root.columns[1].width - 12px) * clamp(root.data.ratio, 0, 1));
        height: parent.height - 10px;
        border-radius: Theme.radius-sm;
        background: root.data.warn ? Theme.warning : Theme.accent;
        opacity: root.data.selected || root.hovered ? 0.28 : 0.18;
        animate width { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 120ms; }
    }

    FileIcon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        icon: root.data.icon;
        folder: root.data.folder;
        dim: root.data.dim;
    }

    HorizontalLayout {
        for column[index] in root.columns: Rectangle {
            width: column.width;

            if index == 1 && root.data.busy: LoadingSpinner {
                x: 10px;
                y: (parent.height - self.height) / 2;
                size: 12px;
                tint: Theme.accent;
            }

            Text {
                x: index == 0 ? 36px : index == 1 && root.data.busy ? 26px : 12px;
                width: parent.width - self.x - 12px;
                height: parent.height;
                text: root.data.cells[index];
                opacity: index == 0 && root.renaming ? 0 : 1;
                font-size: Theme.text-size;
                font-weight: index == 0 && root.data.selected ? 500 : 400;
                vertical-alignment: center;
                horizontal-alignment: column.right-aligned ? right : left;
                overflow: elide;
                color: index == 1 && root.data.warn ? Theme.warning
                    : index == 1 && root.data.busy ? Theme.text-dim
                    : root.data.dim || index > 1 ? Theme.text-dim
                    : Theme.text;
            }
        }
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    if (self.mouse-x < root.total-width) {
                        root.pressed(event.modifiers.control, event.modifiers.shift);
                    } else {
                        root.background-pressed();
                    }
                } else if (event.button == PointerEventButton.right) {
                    if (self.mouse-x < root.total-width) {
                        root.right-pressed(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    } else {
                        root.background-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }
        double-clicked => { if (self.mouse-x < root.total-width) { root.activated(); } }
    }
}

export component FileTable {
    in property <[ColumnInfo]> columns;
    in property <[FileRow]> rows;
    in property <length> total-width;
    in property <string> empty-message;
    callback sort-requested(int);
    callback column-resized(int, length);
    callback row-pressed(int, bool, bool);
    callback row-menu(int, length, length);
    callback background-menu(length, length);
    callback background-pressed();
    callback row-activated(int);
    callback rename-committed(string);
    callback rename-cancelled();

    property <int> rename-row;

    forward-focus: focus;

    public function reveal-row(row: int) {
        if (row * Theme.row-height + list.content-y < 0) {
            list.content-y = 0 - row * Theme.row-height;
        } else if ((row + 1) * Theme.row-height + list.content-y > list.visible-height) {
            list.content-y = list.visible-height - (row + 1) * Theme.row-height;
        }
    }

    public function scroll-to-top() {
        list.content-y = 0;
        list.content-x = 0;
    }

    public function take-focus() {
        focus.focus();
    }

    public function begin-rename(row: int, name: string, selection-end: int) {
        root.rename-row = row;
        root.reveal-row(row);
        rename-box.start(name, selection-end);
    }

    focus := FocusScope {
        width: parent.width;
        height: parent.height;

        VerticalLayout {
            Rectangle {
                height: 32px;
                background: Theme.subtle-surface;
                clip: true;

                HorizontalLayout {
                    x: list.content-x;
                    width: root.total-width;
                    height: 32px;

                    for column[index] in root.columns: HeaderCell {
                        info: column;
                        clicked => {
                            focus.focus();
                            root.sort-requested(index);
                        }
                        resized(width) => { root.column-resized(index, width); }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
            }

            Rectangle {
                clip: true;

                TouchArea {
                    y: max(0px, root.rows.length * Theme.row-height + list.content-y);
                    width: list.visible-width;
                    // Leave the Fluent horizontal scrollbar available below short lists.
                    height: max(0px, list.visible-height - self.y - (list.content-width > list.visible-width ? 14px : 0px));
                    z: 1;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            focus.focus();
                            if (event.button == PointerEventButton.left) {
                                root.background-pressed();
                            } else if (event.button == PointerEventButton.right) {
                                root.background-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                }

                list := ListView {
                    width: parent.width;
                    height: parent.height;

                    for row[index] in root.rows: Row {
                        data: row;
                        columns: root.columns;
                        total-width: root.total-width;
                        renaming: rename-box.active && root.rename-row == index;
                        pressed(control, shift) => {
                            focus.focus();
                            root.row-pressed(index, control, shift);
                        }
                        background-pressed => {
                            focus.focus();
                            root.background-pressed();
                        }
                        background-menu(x, y) => {
                            focus.focus();
                            root.background-menu(x, y);
                        }
                        right-pressed(x, y) => {
                            focus.focus();
                            root.row-menu(index, x, y);
                        }
                        activated => { root.row-activated(index); }
                    }
                }

                rename-box := RenameBox {
                    x: 36px - self.inset + list.content-x;
                    y: root.rename-row * Theme.row-height + list.content-y + (Theme.row-height - self.height) / 2;
                    available-width: root.columns[0].width - 36px;
                    committed(text) => { root.rename-committed(text); }
                    cancelled => { root.rename-cancelled(); }
                }

                if root.rows.length == 0 && root.empty-message != "": EmptyState {
                    width: parent.width;
                    height: parent.height;
                    message: root.empty-message;
                }
            }
        }
    }
}
