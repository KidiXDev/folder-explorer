import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ColumnInfo, FileRow, Span } from "types.slint";
import { DimLabel, DragPreview, EmptyState, FileIcon, ItemTouchArea, LoadingSpinner, MarqueeArea, RenameBox } from "controls.slint";

component HeaderCell {
    in property <ColumnInfo> info;
    callback clicked();
    callback resized(length);

    width: root.info.width;

    Rectangle {
        background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; easing: ease-out; }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 2px;
        width: root.info.sort-direction != 0 ? parent.width - 16px : 0px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
        opacity: root.info.sort-direction != 0 ? 1 : 0;
        animate width { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 140ms; easing: ease-out; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 5px;
        alignment: root.info.right-aligned ? end : start;

        DimLabel {
            text: root.info.title;
            font-weight: root.info.sort-direction != 0 ? 600 : 500;
            color: root.info.sort-direction != 0 || touch.has-hover ? Theme.text : Theme.text-dim;
            horizontal-stretch: 0;
            animate color { duration: 120ms; }
        }

        if root.info.sort-direction != 0: Image {
            source: @image-url("icons/chevron-up.svg");
            width: 12px;
            colorize: Theme.accent;
            transform-rotation: root.info.sort-direction > 0 ? 0deg : 180deg;
            animate transform-rotation { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        y: 6px;
        width: resize-touch.has-hover || resize-touch.pressed ? 2px : 1px;
        height: parent.height - 12px;
        background: resize-touch.has-hover || resize-touch.pressed ? Theme.accent : Theme.line;
        animate background, width { duration: 120ms; }
    }

    resize-touch := TouchArea {
        x: parent.width - 5px;
        width: 8px;
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.resized(max(56px, root.info.width + self.mouse-x - self.pressed-x));
            }
        }
    }
}

component Row {
    in property <FileRow> data;
    in property <[ColumnInfo]> columns;
    in property <length> total-width;
    in property <bool> renaming;
    in property <bool> drop-target;
    in property <MouseCursor> drag-cursor;
    callback touched <=> touch.touched;
    callback pressed <=> touch.item-pressed;
    callback right-pressed <=> touch.right-pressed;
    callback activated <=> touch.double-clicked;
    callback drag-started <=> touch.drag-started;
    callback drag-moved <=> touch.drag-moved;
    callback drag-ended <=> touch.drag-ended;
    callback drag-cancelled <=> touch.drag-cancelled;

    height: Theme.row-height;
    min-width: root.total-width;
    property <bool> hovered: touch.has-hover;

    Rectangle {
        x: 6px;
        y: Theme.item-inset;
        width: root.total-width - 12px;
        height: parent.height - 2 * Theme.item-inset;
        border-radius: Theme.radius;
        border-width: root.data.selected || root.drop-target ? 1px : 0px;
        border-color: root.drop-target ? Theme.accent : Theme.selected-border;
        background: root.drop-target ? Theme.selected-hover
            : root.data.selected ? (root.hovered ? Theme.selected-hover : Theme.selected)
            : root.hovered && touch.pressed ? Theme.pressed
            : root.hovered ? Theme.hover
            : transparent;
    }

    Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.data.selected ? 14px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        opacity: root.data.selected ? 1 : 0;
        animate height { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 130ms; easing: ease-out; }
    }

    if root.data.ratio > 0: Rectangle {
        x: root.columns[0].width + 6px;
        y: 5px;
        width: root.columns[1].width - 12px;
        height: parent.height - 10px;
        border-radius: Theme.radius-sm;
        background: Theme.track;
        opacity: 0.35;
    }

    if root.data.ratio > 0: Rectangle {
        x: root.columns[0].width + 6px;
        y: 5px;
        width: max(3px, (root.columns[1].width - 12px) * clamp(root.data.ratio, 0, 1));
        height: parent.height - 10px;
        border-radius: Theme.radius-sm;
        background: root.data.warn ? Theme.warning : Theme.accent;
        opacity: root.data.selected || root.hovered ? 0.28 : 0.18;
        animate width { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 120ms; }
    }

    FileIcon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        icon: root.data.icon;
        folder: root.data.folder;
        dim: root.data.dim;
    }

    HorizontalLayout {
        for column[index] in root.columns: Rectangle {
            width: column.width;

            if index == 1 && root.data.busy: LoadingSpinner {
                x: 10px;
                y: (parent.height - self.height) / 2;
                size: 12px;
                tint: Theme.accent;
            }

            Text {
                x: index == 0 ? 36px : index == 1 && root.data.busy ? 26px : 12px;
                width: parent.width - self.x - 12px;
                height: parent.height;
                text: root.data.cells[index];
                opacity: index == 0 && root.renaming ? 0 : 1;
                font-size: Theme.text-size;
                font-weight: index == 0 && root.data.selected ? 500 : 400;
                vertical-alignment: center;
                horizontal-alignment: column.right-aligned ? right : left;
                overflow: elide;
                color: index == 1 && root.data.warn ? Theme.warning
                    : index == 1 && root.data.busy ? Theme.text-dim
                    : root.data.dim || index > 1 ? Theme.text-dim
                    : Theme.text;
            }
        }
    }

    touch := ItemTouchArea {
        x: 0px;
        y: Theme.item-inset;
        width: root.total-width;
        height: parent.height - 2 * Theme.item-inset;
        selected: root.data.selected;
        drag-cursor: root.drag-cursor;
    }
}

export component FileTable {
    in property <[ColumnInfo]> columns;
    in property <[FileRow]> rows;
    in property <length> total-width;
    in property <string> empty-message;
    in property <int> drag-count;
    callback sort-requested(int);
    callback column-resized(int, length);
    callback row-pressed(int, bool, bool);
    callback row-menu(int, length, length);
    callback background-menu(length, length);
    callback background-pressed();
    callback marquee-started(bool);
    callback marquee-changed(Span, Span, int);
    callback items-dropped(int, bool);
    callback row-activated(int);
    callback rename-committed(string);
    callback rename-cancelled();

    property <int> rename-row;
    property <int> drag-source;
    property <length> drag-top: marquee.local-y - list.content-y;
    property <length> drag-left: marquee.local-x - list.content-x;
    property <int> drag-row: floor(root.drag-top / Theme.row-height);
    property <length> drag-offset: root.drag-top - root.drag-row * Theme.row-height;
    property <bool> drag-on-row: root.drag-left >= 0 && root.drag-left < root.total-width
        && marquee.local-y >= 0 && marquee.local-y < list.visible-height
        && root.drag-offset >= Theme.item-inset && root.drag-offset < Theme.row-height - Theme.item-inset;
    property <int> drop-row: marquee.dragging-items && root.drag-on-row && root.drag-row >= 0 && root.drag-row < root.rows.length
        && root.rows[root.drag-row].folder && !root.rows[root.drag-row].selected ? root.drag-row : -1;
    property <MouseCursor> drag-cursor: !marquee.dragging-items ? MouseCursor.default
        : root.drop-row < 0 ? MouseCursor.no-drop
        : marquee.drag-copy ? MouseCursor.copy
        : MouseCursor.move;

    forward-focus: focus;

    public function reveal-row(row: int) {
        if (row * Theme.row-height + list.content-y < 0) {
            list.content-y = 0 - row * Theme.row-height;
        } else if ((row + 1) * Theme.row-height + list.content-y > list.visible-height) {
            list.content-y = list.visible-height - (row + 1) * Theme.row-height;
        }
    }

    public function scroll-to-top() {
        list.content-y = 0;
        list.content-x = 0;
    }

    public function take-focus() {
        focus.focus();
    }

    public function begin-rename(row: int, name: string, selection-end: int) {
        root.rename-row = row;
        root.reveal-row(row);
        rename-box.start(name, selection-end);
    }

    public pure function menu-anchor(row: int) -> Point {
        return { x: 36px, y: 32px + max(0px, (row + 1) * Theme.row-height + list.content-y) };
    }

    focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape && marquee.dragging) {
                marquee.cancel();
                return accept;
            }
            reject
        }

        VerticalLayout {
            Rectangle {
                height: 32px;
                background: Theme.subtle-surface;
                clip: true;

                HorizontalLayout {
                    x: list.content-x;
                    width: root.total-width;
                    height: 32px;

                    for column[index] in root.columns: HeaderCell {
                        info: column;
                        clicked => {
                            focus.focus();
                            root.sort-requested(index);
                        }
                        resized(width) => { root.column-resized(index, width); }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.line;
                }
            }

            Rectangle {
                clip: true;

                marquee := MarqueeArea {
                    width: parent.width;
                    height: parent.height;
                    scroll-x: list.content-x;
                    scroll-y <=> list.content-y;
                    scroll-limit: min(0px, list.visible-height - list.content-height);
                    touched => { focus.focus(); }
                    background-pressed => { root.background-pressed(); }
                    background-menu(x, y) => { root.background-menu(x, y); }
                    started(additive) => { root.marquee-started(additive); }
                    changed(left, top, right, bottom) => {
                        root.marquee-changed(
                            { start: top, end: bottom, pitch: Theme.row-height, inset: Theme.item-inset },
                            { start: left, end: right, pitch: root.total-width, inset: 0px },
                            1);
                    }
                    items-dropped(copy) => {
                        if (root.drop-row >= 0) {
                            root.items-dropped(root.drop-row, copy);
                        }
                    }

                    list := ListView {
                        width: parent.width;
                        height: parent.height;

                        for row[index] in root.rows: Row {
                            data: row;
                            columns: root.columns;
                            total-width: root.total-width;
                            renaming: rename-box.active && root.rename-row == index;
                            drop-target: root.drop-row == index;
                            drag-cursor: root.drag-cursor;
                            touched => { focus.focus(); }
                            pressed(control, shift) => { root.row-pressed(index, control, shift); }
                            right-pressed(x, y) => { root.row-menu(index, x, y); }
                            activated => { root.row-activated(index); }
                            drag-started(selecting, x, y) => {
                                root.drag-source = index;
                                marquee.item-drag-started(selecting, x, y);
                            }
                            drag-moved(x, y, copy) => { marquee.item-drag-moved(x, y, copy); }
                            drag-ended(copy) => { marquee.item-drag-ended(copy); }
                            drag-cancelled => { marquee.cancel(); }
                        }
                    }
                }

                rename-box := RenameBox {
                    x: 36px - self.inset + list.content-x;
                    y: root.rename-row * Theme.row-height + list.content-y + (Theme.row-height - self.height) / 2;
                    available-width: root.columns[0].width - 36px;
                    committed(text) => { root.rename-committed(text); }
                    cancelled => { root.rename-cancelled(); }
                }

                if root.rows.length == 0 && root.empty-message != "": EmptyState {
                    width: parent.width;
                    height: parent.height;
                    message: root.empty-message;
                }
            }
        }

        if marquee.dragging-items: DragPreview {
            width: parent.width;
            height: parent.height;
            pointer-x: marquee.absolute-position.x + marquee.local-x - self.absolute-position.x;
            pointer-y: marquee.absolute-position.y + marquee.local-y - self.absolute-position.y;
            icon: root.rows[root.drag-source].icon;
            folder: root.rows[root.drag-source].folder;
            count: root.drag-count;
            copy: marquee.drag-copy;
            target: root.drop-row >= 0 ? root.rows[root.drop-row].cells[0] : "";
        }
    }
}
