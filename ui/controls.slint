import { Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component PopoverItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> checked;
    in property <bool> checkable;
    in property <bool> radio;
    in property <bool> enabled: true;
    in property <bool> highlighted;
    in property <bool> submenu;
    in property <bool> active-submenu;
    in property <bool> separator-before;
    callback activated();
    callback hovered();

    private property <length> row-height: 34px;

    height: root.separator-before ? root.row-height + 9px : root.row-height;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { if (root.enabled) { root.activated(); } }

    if root.separator-before: Rectangle {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.line;
    }

    Rectangle {
        y: root.separator-before ? 9px : 0px;
        height: root.row-height;
        border-radius: Theme.radius;
        background: !root.enabled ? transparent
            : touch.pressed ? Theme.pressed
            : (touch.has-hover || root.highlighted || root.active-submenu) ? Theme.hover
            : (root.radio && root.checked) ? Theme.selected
            : transparent;
        animate background { duration: 110ms; easing: ease-out; }

        if root.radio: Rectangle {
            x: 0px;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: root.checked ? 16px : 0px;
            border-radius: 1.5px;
            background: Theme.accent;
            opacity: root.checked ? 1 : 0;
            animate height { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            animate opacity { duration: 120ms; easing: ease-out; }
        }

        if root.checkable && !root.radio: Image {
            x: 15px - self.width / 2;
            y: (parent.height - self.height) / 2;
            width: root.checked ? 14px : 10px;
            height: root.checked ? 14px : 10px;
            source: @image-url("icons/check.svg");
            colorize: Theme.accent;
            opacity: root.checked ? 1 : 0;
            accessible-role: none;
            animate width, height { duration: 150ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            animate opacity { duration: 120ms; easing: ease-out; }
        }

        if root.icon.width > 0: Image {
            x: root.checkable && !root.radio ? 28px : 12px;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: !root.enabled ? Theme.text-faint : root.checked ? Theme.accent : Theme.text;
            accessible-role: none;
            animate colorize { duration: 120ms; }
        }

        Text {
            x: root.icon.width > 0 ? (root.checkable && !root.radio ? 52px : 36px) : (root.checkable && !root.radio ? 32px : 14px);
            width: parent.width - self.x - (root.submenu ? 28px : 12px);
            height: parent.height;
            text: root.text;
            color: root.enabled ? Theme.text : Theme.text-faint;
            font-size: Theme.text-size;
            font-weight: root.checked ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.submenu: Image {
            x: parent.width - 22px + (root.active-submenu ? 2px : 0px);
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            source: @image-url("icons/chevron-right.svg");
            colorize: root.active-submenu ? Theme.accent : Theme.text-dim;
            animate x, colorize { duration: 140ms; easing: ease-out; }
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.activated(); }
            changed has-hover => {
                if (self.has-hover && root.enabled) {
                    root.hovered();
                }
            }
        }
    }
}

export component MenuPopover inherits Rectangle {
    in-out property <bool> open;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <length> panel-width: 236px;
    in property <length> commandbar-top: Theme.titlebar-height + Theme.toolbar-height + 1px;
    in property <length> commandbar-bottom: Theme.titlebar-height + Theme.toolbar-height + Theme.commandbar-height + 1px;
    in property <int> item-count;
    in-out property <int> current-index: -1;
    in-out property <int> submenu-open: 0;
    out property <int> displayed-submenu: 1;
    in property <int> submenu-item-count: 0;
    in-out property <int> submenu-index: -1;
    out property <length> panel-x: panel.x;
    out property <length> panel-y: panel.y;
    callback activated(int);
    callback submenu-activated(int);
    callback open-submenu(int);
    callback dismissed();

    private property <float> enter: root.open ? 1 : 0;
    animate enter { duration: 180ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    private property <float> fade: root.open ? 1 : 0;
    animate fade { duration: 115ms; easing: ease-out; }
    visible: root.open || root.fade > 0.01;

    private property <length> full-height: min(items.preferred-height + 10px, root.height - root.anchor-y - 14px);
    animate full-height { duration: 165ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    changed submenu-open => {
        if (root.submenu-open != 0) {
            root.displayed-submenu = root.submenu-open;
        }
    }

    changed open => {
        if (root.open) {
            root.current-index = -1;
            root.submenu-open = 0;
            root.submenu-index = -1;
            scroll.content-y = 0px;
            menu-focus.focus();
        } else {
            root.submenu-open = 0;
            root.submenu-index = -1;
            root.dismissed();
        }
    }

    changed item-count => { root.current-index = -1; }

    TouchArea {
        y: 0;
        height: root.commandbar-top;
        enabled: root.open;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.open = false; }
        }
    }

    TouchArea {
        y: root.commandbar-bottom;
        height: max(0px, root.height - self.y);
        enabled: root.open;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.open = false; }
        }
    }

    menu-focus := FocusScope {
        x: panel.x;
        y: panel.y;
        width: panel.width;
        height: panel.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.submenu-open != 0) {
                    root.submenu-open = 0;
                    root.submenu-index = -1;
                } else {
                    root.open = false;
                }
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                if (root.submenu-open != 0 && root.submenu-item-count > 0) {
                    root.submenu-index = root.submenu-index < 0
                        ? (event.text == Key.DownArrow ? 0 : root.submenu-item-count - 1)
                        : mod(root.submenu-index + (event.text == Key.DownArrow ? 1 : root.submenu-item-count - 1), root.submenu-item-count);
                } else if (root.item-count > 0) {
                    root.current-index = root.current-index < 0
                        ? (event.text == Key.DownArrow ? 0 : root.item-count - 1)
                        : mod(root.current-index + (event.text == Key.DownArrow ? 1 : root.item-count - 1), root.item-count);
                }
                return accept;
            }
            if (event.text == Key.Home) {
                if (root.submenu-open != 0) { root.submenu-index = 0; }
                else { root.current-index = 0; }
                return accept;
            }
            if (event.text == Key.End) {
                if (root.submenu-open != 0) { root.submenu-index = root.submenu-item-count - 1; }
                else { root.current-index = root.item-count - 1; }
                return accept;
            }
            if (event.text == Key.LeftArrow || event.text == Key.Backspace) {
                if (root.submenu-open != 0) {
                    root.submenu-open = 0;
                    root.submenu-index = -1;
                } else {
                    root.open = false;
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (root.submenu-open == 0 && root.current-index >= 0) {
                    root.open-submenu(root.current-index);
                }
                return accept;
            }
            if ((event.text == Key.Return || event.text == " ") && (root.current-index >= 0 || root.submenu-index >= 0)) {
                if (root.submenu-open != 0 && root.submenu-index >= 0) {
                    root.submenu-activated(root.submenu-index);
                } else if (root.current-index >= 0) {
                    root.activated(root.current-index);
                }
                return accept;
            }
            if (event.text == Key.Tab) { root.open = false; return accept; }
            reject
        }
    }

    panel := Rectangle {
        x: clamp(root.anchor-x, 8px, root.width - self.width - 8px);
        y: min(root.anchor-y + 5px, root.height - root.full-height - 8px)
            + (root.open ? (1 - root.enter) * -8px : (1 - root.fade) * -4px);
        width: root.panel-width;
        height: root.full-height * (root.open ? (0.86 + 0.14 * root.enter) : (0.96 + 0.04 * root.fade));
        opacity: root.open ? clamp(root.enter * 1.25, 0, 1) : root.fade;
        clip: true;
        background: Theme.flyout;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.flyout-border;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.dark ? #00000072 : #00000022;

        TouchArea {
            enabled: root.open;
        }

        scroll := ScrollView {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            height: max(0px, root.full-height - 10px);
            content-height: items.preferred-height;
            content-width: self.visible-width;

            items := VerticalLayout {
                width: scroll.visible-width;
                height: self.preferred-height;
                spacing: 1px;
                @children
            }
        }
    }

    changed current-index => {
        if (root.current-index >= 0) {
            scroll.content-y = clamp(scroll.content-y, 0 - root.current-index * 35px, min(0px, scroll.visible-height - (root.current-index + 1) * 35px));
        }
    }
}

export component SubmenuPopover inherits Rectangle {
    in property <bool> open;
    in property <length> window-width;
    in property <length> window-height;
    in property <length> parent-x;
    in property <length> parent-y;
    in property <length> parent-width;
    in property <length> offset-y;
    in property <length> panel-width: 204px;

    private property <float> enter: root.open ? 1 : 0;
    animate enter { duration: 170ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
    private property <float> fade: root.open ? 1 : 0;
    animate fade { duration: 110ms; easing: ease-out; }
    visible: root.open || root.fade > 0.01;

    private property <bool> open-right: root.parent-x + root.parent-width + root.panel-width + 12px <= root.window-width;
    private property <length> target-x: root.open-right
        ? root.parent-x + root.parent-width + 4px
        : max(8px, root.parent-x - root.panel-width - 4px);
    private property <length> slide-x: (root.open-right ? -1 : 1) * (root.open ? (1 - root.enter) * 6px : (1 - root.fade) * 4px);
    private property <length> full-height: min(items.preferred-height + 10px, root.window-height - root.parent-y - 14px);
    animate full-height { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    private property <length> base-y: clamp(root.parent-y + root.offset-y, 8px, max(8px, root.window-height - root.full-height - 8px));
    animate base-y { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }

    x: root.target-x + root.slide-x;
    y: root.base-y + (root.open ? (1 - root.enter) * -4px : 0px);
    width: root.panel-width;
    height: root.full-height * (root.open ? (0.88 + 0.12 * root.enter) : (0.96 + 0.04 * root.fade));
    opacity: root.open ? clamp(root.enter * 1.25, 0, 1) : root.fade;
    clip: true;
    background: Theme.flyout;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.flyout-border;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.dark ? #00000072 : #00000022;

    TouchArea {
        enabled: root.open;
    }

    scroll := ScrollView {
        x: 5px;
        y: 5px;
        width: parent.width - 10px;
        height: max(0px, root.full-height - 10px);
        content-height: items.preferred-height;
        content-width: self.visible-width;

        items := VerticalLayout {
            width: scroll.visible-width;
            height: self.preferred-height;
            spacing: 1px;
            @children
        }
    }
}

export component IconButton {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked();

    width: 34px;
    height: 34px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        border-radius: Theme.radius;
        border-width: root.active && root.enabled ? 1px : 0px;
        border-color: Theme.selected-border;
        background: !root.enabled ? transparent
            : touch.pressed ? Theme.pressed
            : root.active ? (touch.has-hover ? Theme.selected-hover : Theme.selected)
            : touch.has-hover ? Theme.hover
            : transparent;
        animate background { duration: 120ms; easing: ease-out; }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 3px;
        width: root.active && root.enabled ? (touch.has-hover ? 16px : 12px) : 0px;
        height: 2.5px;
        border-radius: 1.25px;
        background: Theme.accent;
        opacity: root.active && root.enabled ? 1 : 0;
        animate width { duration: 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 140ms; easing: ease-out; }
    }

    Image {
        source: root.icon;
        width: touch.pressed && root.enabled ? 15px : 17px;
        height: touch.pressed && root.enabled ? 15px : 17px;
        colorize: !root.enabled ? Theme.text-faint : root.active ? Theme.accent : Theme.text;
        animate width, height { duration: 100ms; easing: ease-out; }
        animate colorize { duration: 120ms; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component CaptionButton {
    in property <image> icon;
    in property <string> label;
    in property <bool> danger;
    callback clicked();

    property <bool> danger-shown: root.danger && (touch.has-hover || touch.pressed);

    width: 46px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        background: root.danger-shown ? (touch.pressed ? Theme.caption-close-pressed : Theme.caption-close)
            : touch.pressed ? Theme.pressed
            : touch.has-hover ? Theme.hover
            : transparent;
        animate background { duration: 120ms; easing: ease-out; }
    }

    Image {
        source: root.icon;
        width: 10px;
        height: 10px;
        colorize: root.danger-shown ? #ffffff : Theme.text;
        animate colorize { duration: 120ms; }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component CommandButton {
    in property <image> icon;
    in property <string> text;
    in property <string> label: root.text;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <bool> opens-menu;
    callback clicked();

    height: 32px;
    min-width: max(34px, layout.preferred-width);
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        border-radius: Theme.radius;
        border-width: root.enabled && (root.active || touch.has-hover || touch.pressed) ? 1px : 0px;
        border-color: root.active ? Theme.selected-border : Theme.control-border;
        background: !root.enabled ? transparent
            : touch.pressed ? Theme.pressed
            : root.active ? (touch.has-hover ? Theme.selected-hover : Theme.selected)
            : touch.has-hover ? Theme.hover
            : transparent;
        animate background, border-color { duration: 120ms; easing: ease-out; }
    }

    layout := HorizontalLayout {
        padding-left: root.text != "" ? 10px : 8px;
        padding-right: root.text != "" ? 10px : 8px;
        spacing: 6px;

        Rectangle {
            width: 16px;

            Image {
                source: root.icon;
                width: touch.pressed && root.enabled ? 15px : 16px;
                height: touch.pressed && root.enabled ? 15px : 16px;
                colorize: !root.enabled ? Theme.text-faint : root.active ? Theme.accent : Theme.text;
                animate width, height { duration: 100ms; easing: ease-out; }
                animate colorize { duration: 120ms; }
            }
        }

        if root.text != "": Text {
            text: root.text;
            font-size: Theme.text-size;
            font-weight: 500;
            vertical-alignment: center;
            color: root.enabled ? Theme.text : Theme.text-faint;
            animate color { duration: 120ms; }
        }

        if root.opens-menu: Rectangle {
            width: 10px;

            Image {
                source: @image-url("icons/chevron-down.svg");
                width: 10px;
                height: 10px;
                colorize: !root.enabled ? Theme.text-faint : root.active ? Theme.accent : Theme.text-dim;
                transform-rotation: root.active ? 180deg : 0deg;
                animate transform-rotation { duration: 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                animate colorize { duration: 120ms; }
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component LoadingSpinner {
    in property <length> size: 15px;
    in property <brush> tint: Theme.accent;

    width: root.size;
    height: root.size;

    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("icons/spinner.svg");
        colorize: root.tint;
        transform-rotation: 360deg * mod(animation-tick(), 720ms) / 720ms;
    }
}

export component IndeterminateBar inherits Rectangle {
    in property <bool> active;

    height: 2px;
    clip: true;

    if root.active: Rectangle {
        property <float> phase: mod(animation-tick(), 1100ms) / 1100ms;

        x: (parent.width + 220px) * self.phase - 220px;
        width: 220px;
        height: parent.height;
        border-radius: 1px;
        background: @linear-gradient(90deg, transparent 0%, Theme.accent 50%, transparent 100%);
    }
}

export component FileIcon {
    in property <image> icon;
    in property <bool> folder;
    in property <bool> dim;

    Image {
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        source: root.icon.width > 0 ? root.icon
            : root.folder ? @image-url("icons/folder.svg")
            : @image-url("icons/file.svg");
        colorize: root.icon.width > 0 ? transparent : root.folder ? Theme.folder : Theme.text-dim;
        opacity: root.dim ? 0.5 : 1;
    }
}

export component RenameBox {
    in-out property <bool> active;
    in property <length> available-width;
    out property <length> inset: 5px;
    callback committed(string);
    callback cancelled();

    public function start(name: string, selection-end: int) {
        root.active = true;
        edit.text = name;
        edit.focus();
        edit.set-selection-offsets(0, selection-end);
    }

    visible: root.active;
    width: min(root.available-width, max(48px, edit.preferred-width + edit.text-cursor-width + 2 * root.inset));
    height: 24px;

    Rectangle {
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.accent;
        background: Theme.input-active;
    }

    TouchArea { }

    Rectangle {
        x: root.inset;
        width: root.width - 2 * root.inset;
        clip: true;

        ContextMenuArea {
            Menu {
                MenuItem {
                    title: "Cut";
                    activated => { edit.cut(); }
                }

                MenuItem {
                    title: "Copy";
                    activated => { edit.copy(); }
                }

                MenuItem {
                    title: "Paste";
                    activated => { edit.paste(); }
                }

                MenuSeparator { }

                MenuItem {
                    title: "Select all";
                    activated => { edit.select-all(); }
                }
            }

            edit := TextInput {
                property <length> scroll-x;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                font-size: Theme.text-size;
                font-weight: 500;
                selection-background-color: Palette.selection-background;
                selection-foreground-color: #ffffff;

                cursor-position-changed(position) => {
                    if (position.x + self.scroll-x < 0px) {
                        self.scroll-x = 0px - position.x;
                    } else if (position.x + self.scroll-x > parent.width - self.text-cursor-width) {
                        self.scroll-x = parent.width - position.x - self.text-cursor-width;
                    }
                }
                accepted => {
                    if (root.active) {
                        root.active = false;
                        root.committed(self.text);
                    }
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.active = false;
                        root.cancelled();
                        return accept;
                    }
                    reject
                }
                changed has-focus => {
                    if (!self.has-focus && root.active) {
                        root.active = false;
                        root.committed(self.text);
                    }
                }
            }
        }
    }
}

export component UsageBar {
    in property <float> ratio;
    in property <bool> nearly-full;

    height: 6px;

    Rectangle {
        border-radius: self.height / 2;
        background: Theme.track;
        clip: true;

        Rectangle {
            x: 0;
            width: parent.width * clamp(root.ratio, 0, 1);
            height: parent.height;
            border-radius: self.height / 2;
            background: root.nearly-full ? Theme.danger : Theme.accent;
            animate width { duration: 220ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
            animate background { duration: 160ms; }
        }
    }
}

export component Label inherits Text {
    color: Theme.text;
    font-size: Theme.text-size;
    vertical-alignment: center;
    overflow: elide;
}

export component DimLabel inherits Text {
    color: Theme.text-dim;
    font-size: Theme.small-text-size;
    vertical-alignment: center;
    overflow: elide;
}

export component MarqueeArea inherits TouchArea {
    in property <length> scroll-x;
    in-out property <length> scroll-y;
    in property <length> scroll-limit;
    callback touched();
    callback background-pressed();
    callback background-menu(x: length, y: length);
    callback started(additive: bool);
    callback changed(left: length, top: length, right: length, bottom: length);
    callback items-dropped(copy: bool);

    out property <bool> dragging-items;
    out property <bool> drag-copy;
    out property <bool> dragging: root.dragging-items || root.active;
    out property <length> local-x;
    out property <length> local-y;
    property <bool> armed;
    property <bool> active;
    property <bool> additive;
    property <length> origin-x;
    property <length> origin-y;
    property <length> pointer-x: root.local-x - root.scroll-x;
    property <length> pointer-y: root.local-y - root.scroll-y;
    property <length> drag-threshold: 4px;
    property <length> scroll-edge: 24px;
    property <length> scroll-step: root.local-y < root.scroll-edge ? (root.local-y - root.scroll-edge) / 4
        : root.local-y > root.height - root.scroll-edge ? (root.local-y - root.height + root.scroll-edge) / 4
        : 0px;

    function report() {
        root.changed(min(root.origin-x, root.pointer-x), min(root.origin-y, root.pointer-y),
            max(root.origin-x, root.pointer-x), max(root.origin-y, root.pointer-y));
    }

    function begin(x: length, y: length, additive: bool) {
        root.local-x = x;
        root.local-y = y;
        root.armed = true;
        root.additive = additive;
        root.origin-x = root.pointer-x;
        root.origin-y = root.pointer-y;
    }

    function track(x: length, y: length) {
        root.local-x = x;
        root.local-y = y;
        if (root.armed && !root.active
            && (abs(root.pointer-x - root.origin-x) > root.drag-threshold || abs(root.pointer-y - root.origin-y) > root.drag-threshold)) {
            root.active = true;
            root.started(root.additive);
        }
        if (root.active) {
            root.report();
        }
    }

    public function cancel() {
        root.armed = false;
        root.active = false;
        root.dragging-items = false;
    }

    public function item-drag-started(marquee: bool, x: length, y: length) {
        if (marquee) {
            root.begin(x - root.absolute-position.x, y - root.absolute-position.y, true);
        } else {
            root.dragging-items = true;
            root.drag-copy = false;
        }
    }

    public function item-drag-moved(x: length, y: length, copy: bool) {
        root.drag-copy = copy;
        root.track(x - root.absolute-position.x, y - root.absolute-position.y);
    }

    public function item-drag-ended(copy: bool) {
        if (root.dragging-items) {
            root.items-dropped(copy);
        }
        root.cancel();
    }

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            root.touched();
            if (event.button == PointerEventButton.left) {
                root.begin(self.mouse-x, self.mouse-y, event.modifiers.control);
                if (!root.additive) {
                    root.background-pressed();
                }
            } else if (event.button == PointerEventButton.right) {
                root.background-menu(root.absolute-position.x + root.mouse-x, root.absolute-position.y + root.mouse-y);
            }
        } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
            root.cancel();
        }
    }

    moved => { root.track(self.mouse-x, self.mouse-y); }

    @children

    Timer {
        interval: 16ms;
        running: root.dragging && root.scroll-step != 0px;
        triggered => {
            let target = clamp(root.scroll-y - root.scroll-step, root.scroll-limit, 0px);
            if (target != root.scroll-y) {
                root.scroll-y = target;
                if (root.active) {
                    root.report();
                }
            }
        }
    }

    if root.active: Rectangle {
        x: min(root.origin-x, root.pointer-x) + root.scroll-x;
        y: min(root.origin-y, root.pointer-y) + root.scroll-y;
        width: abs(root.pointer-x - root.origin-x);
        height: abs(root.pointer-y - root.origin-y);
        background: Theme.selected-border;
        border-width: 1px;
        border-color: Theme.accent;
    }
}

export component ItemTouchArea inherits TouchArea {
    in property <bool> selected;
    in property <MouseCursor> drag-cursor;
    callback touched();
    callback item-pressed(control: bool, shift: bool);
    callback right-pressed(x: length, y: length);
    callback drag-started(marquee: bool, x: length, y: length);
    callback drag-moved(x: length, y: length, copy: bool);
    callback drag-ended(copy: bool);
    callback drag-cancelled();

    property <bool> armed;
    property <bool> dragging;
    property <bool> marquee;
    property <bool> deferred;
    property <bool> copy;
    property <length> drag-threshold: 4px;
    property <length> pointer-x: root.absolute-position.x + root.mouse-x;
    property <length> pointer-y: root.absolute-position.y + root.mouse-y;

    mouse-cursor: root.dragging && !root.marquee ? root.drag-cursor : MouseCursor.default;

    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            root.touched();
            if (event.button == PointerEventButton.left) {
                root.armed = true;
                root.dragging = false;
                root.marquee = event.modifiers.control;
                root.deferred = root.selected && !event.modifiers.control && !event.modifiers.shift;
                if (!root.deferred) {
                    root.item-pressed(event.modifiers.control, event.modifiers.shift);
                }
            } else if (event.button == PointerEventButton.right) {
                root.right-pressed(root.pointer-x, root.pointer-y);
            }
        } else if (event.kind == PointerEventKind.move) {
            root.copy = event.modifiers.control;
        } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
            if (root.dragging) {
                root.drag-ended(event.modifiers.control);
            } else if (root.armed && root.deferred) {
                root.item-pressed(false, false);
            }
            root.armed = false;
            root.dragging = false;
        } else if (event.kind == PointerEventKind.cancel) {
            if (root.dragging) {
                root.drag-cancelled();
            }
            root.armed = false;
            root.dragging = false;
        }
    }

    moved => {
        if (root.armed && !root.dragging
            && (abs(root.mouse-x - root.pressed-x) > root.drag-threshold || abs(root.mouse-y - root.pressed-y) > root.drag-threshold)) {
            root.dragging = true;
            root.drag-started(root.marquee, root.absolute-position.x + root.pressed-x, root.absolute-position.y + root.pressed-y);
        }
        if (root.dragging) {
            root.drag-moved(root.pointer-x, root.pointer-y, root.copy);
        }
    }
}

component DragCard inherits Rectangle {
    width: 96px;
    height: 96px;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.flyout-border;
    background: Theme.flyout;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.drag-shadow;
}

export component DragPreview {
    in property <image> icon;
    in property <bool> folder;
    in property <int> count;
    in property <bool> copy;
    in property <string> target;
    in property <length> pointer-x;
    in property <length> pointer-y;

    property <length> card-x: root.pointer-x - 36px;
    property <length> card-y: root.pointer-y - 104px;
    property <int> crisp-icon-pixels: 48;

    if root.count > 1: DragCard {
        x: root.card-x + 6px;
        y: root.card-y - 6px;
        opacity: 0.6;
    }

    DragCard {
        x: root.card-x;
        y: root.card-y;
        opacity: 0.92;

        FileIcon {
            width: 64px;
            height: 64px;
            icon: root.icon.width >= root.crisp-icon-pixels ? root.icon : @image-url("");
            folder: root.folder;
        }
    }

    if root.count > 1: Rectangle {
        x: root.card-x + 96px - self.width / 2;
        y: root.card-y - self.height / 2;
        width: max(20px, badge-text.preferred-width + 10px);
        height: 20px;
        border-radius: 10px;
        background: Theme.accent;

        badge-text := Text {
            text: root.count;
            color: Palette.accent-foreground;
            font-size: Theme.small-text-size;
            font-weight: 600;
        }
    }

    if root.target != "": Rectangle {
        x: root.pointer-x + 4px;
        y: root.pointer-y + 20px;
        width: hint.preferred-width;
        height: 24px;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.flyout-border;
        background: Theme.flyout;
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.drag-shadow;

        hint := HorizontalLayout {
            padding-left: 6px;
            padding-right: 8px;
            spacing: 5px;

            Image {
                source: root.copy ? @image-url("icons/plus.svg") : @image-url("icons/forward.svg");
                width: 12px;
                colorize: Theme.text;
            }

            Text {
                text: root.copy ? "Copy to" : "Move to";
                color: Theme.text;
                font-size: Theme.small-text-size;
                vertical-alignment: center;
            }

            Text {
                text: root.target;
                color: Theme.accent;
                font-size: Theme.small-text-size;
                vertical-alignment: center;
                overflow: elide;
                max-width: 240px;
            }
        }
    }
}

export component EmptyState {
    in property <string> message;
    in property <image> icon: @image-url("icons/folder.svg");

    VerticalLayout {
        alignment: center;
        spacing: 10px;
        padding: 32px;

        Rectangle {
            height: 48px;

            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: Theme.hover;

                Image {
                    source: root.icon;
                    width: 22px;
                    height: 22px;
                    colorize: Theme.text-faint;
                }
            }
        }

        DimLabel {
            text: root.message;
            horizontal-alignment: center;
            wrap: word-wrap;
            font-size: Theme.text-size;
        }
    }
}
