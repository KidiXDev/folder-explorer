export struct ColumnInfo {
    title: string,
    width: length,
    right-aligned: bool,
    sort-direction: int,
}

export struct FileRow {
    cells: [string],
    icon: image,
    subtitle: string,
    folder: bool,
    selected: bool,
    ratio: float,
    busy: bool,
    warn: bool,
    dim: bool,
}

export struct Span {
    start: length,
    end: length,
    pitch: length,
    inset: length,
}

export struct TreeRow {
    name: string,
    depth: int,
    expanded: bool,
    expandable: bool,
    selected: bool,
    kind: int,
    icon: image,
}

export struct Crumb {
    name: string,
    target: string,
}

export struct DriveCard {
    title: string,
    detail: string,
    path: string,
    icon: image,
    ratio: float,
    nearly-full: bool,
}

export struct SummaryRow {
    label: string,
    detail: string,
    percent: string,
    ratio: float,
    share: float,
    color: color,
}

export struct TreemapTile {
    index: int,
    label: string,
    detail: string,
    percent: string,
    x: float,
    y: float,
    w: float,
    h: float,
    color: color,
}

export struct ColumnChoice {
    title: string,
    shown: bool,
}
